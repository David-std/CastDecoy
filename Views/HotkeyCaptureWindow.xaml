<Window x:Class="CastDecoy.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignar Atajo - CastDecoy"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F5F5F7" Foreground="#1D1D1F"
        FontFamily="'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif" FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="DialogTitleText" Text="Asignar atajo"
                   FontSize="14.5" FontWeight="SemiBold" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis"/>

        <!-- Status banner -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E5EA" BorderThickness="1"
                CornerRadius="8" Padding="10,7" Margin="0,10,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#FF3B30" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Grabando teclas:" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D1D1F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Presiona la combinación deseada en tu teclado" FontSize="11" Foreground="#6E6E73" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Key combination preview -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D1D1D6" BorderThickness="1"
                CornerRadius="10" Padding="16,12" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="260">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.05"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#F2F2F7" BorderBrush="#D1D1D6" BorderThickness="1,1,1,2"
                        CornerRadius="6" Padding="14,6" HorizontalAlignment="Center">
                    <TextBlock x:Name="LivePreviewText" Text="Ctrl + Alt + ..."
                               FontSize="18" FontWeight="SemiBold" Foreground="#5B8DF7"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Pulsación detectada en tiempo real" FontSize="10.5" Foreground="#86868B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Quitar atajo" Style="{StaticResource SecondaryPillBtn}" Height="28" Padding="12,0"
                    Click="OnClearClick" HorizontalAlignment="Left"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryPillBtn}" Height="28" Padding="12,0"
                        Click="OnCancelClick" Margin="0,0,8,0"/>
                <Button Content="Guardar" Style="{StaticResource PrimaryPillBtn}" Height="28" Padding="16,0"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
