                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 4 group -->
                                <Border Grid.Column="0" Background="{StaticResource SubCardBgBrush}"
                                        BorderBrush="{StaticResource SubCardBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 0: Propiedad isExtended -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                                <TextBlock Text="isExtended" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="DiagExtendedIndicator" Width="7" Height="7" CornerRadius="1.5"
                                                        Background="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" x:Name="DiagExtendedSub" Text="Screen.prototype neutralizado" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <!-- Divider 1 -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource DividerLineBrush}" Margin="12,2" VerticalAlignment="Stretch"/>

                                        <!-- 1: Screen Details API -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                                <TextBlock Text="Screen Details API" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="DiagScreensIndicator" Width="7" Height="7" CornerRadius="1.5"
                                                        Background="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" x:Name="DiagScreensSub" Text="Arreglo screens bloqueado en 1" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <!-- Divider 2 -->
                                        <Border Grid.Column="3" Width="1" Background="{StaticResource DividerLineBrush}" Margin="12,2" VerticalAlignment="Stretch"/>

                                        <!-- 2: Offsets de Monitor -->
                                        <Grid Grid.Column="4" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                                <TextBlock Text="Offsets Secundarios" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="DiagOffsetsIndicator" Width="7" Height="7" CornerRadius="1.5"
                                                        Background="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" x:Name="DiagOffsetsSub" Text="availLeft / availTop: 0" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                        </Grid>

                                        <!-- Divider 3 -->
                                        <Border Grid.Column="5" Width="1" Background="{StaticResource DividerLineBrush}" Margin="12,2" VerticalAlignment="Stretch"/>

                                        <!-- 3: Anti-Automatización -->
                                        <Grid Grid.Column="6" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                                <TextBlock Text="Anti-Automatización" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="DiagWebdriverIndicator" Width="7" Height="7" CornerRadius="1.5"
                                                        Background="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" x:Name="DiagWebdriverSub" Text="AutomationControlled oculto" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Fuera de la card: Botón contraer y Leyenda -->
                                <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Botón contraer -->
                                    <Button Grid.Row="0" Style="{StaticResource SecondaryPillBtn}"
                                            Width="28" Height="26" Padding="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            ToolTip="Contraer diagnóstico"
                                            Click="OnCollapseDiagnosticClick">
                                        <Path Data="M12 4 L4 12 H20 Z M4 15 H20 V17 H4 Z"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Stretch="Uniform" Width="11" Height="11"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Leyenda ON/OFF -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border Width="6" Height="6" CornerRadius="1.5" Background="{StaticResource AccentBlueBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ON" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <Border Width="6" Height="6" CornerRadius="1.5" Background="{StaticResource TextMutedBrush}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="OFF" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Ventanas en Vivo (DWM Miniatures) -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceWhite}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Section Toolbar -->
                            <RowDefinition Height="*"/>    <!-- Windows Grid -->
                        </Grid.RowDefinitions>

                        <!-- Header & Actions con línea divisora de 1px cortando de extremo a extremo -->
                        <Border Grid.Row="0" Padding="16,12,16,12"
                                BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5z M2 8h20"
                                          Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ventanas visibles en captura" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Aísla u oculta ventanas individuales para que no aparezcan en grabaciones ni videollamadas compartidas."/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ToggleAllProtectionButton" Style="{StaticResource PrimaryPillBtn}" Height="28" Padding="14,0"
                                            Content="Ocultar todas" Click="OnToggleAllProtectionClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Windows ItemsControl Grid (alineado arriba cuando hay pocas ventanas) -->
                        <ScrollViewer x:Name="Tab1ScrollViewer" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                                      Padding="10,8,10,12"
                                      SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ListBox x:Name="WindowListBox" Background="Transparent" BorderThickness="0"
                                     ItemTemplate="{StaticResource WindowCardTemplate}"
                                     VerticalAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     SnapsToDevicePixels="True" UseLayoutRounding="True"
                                     SelectionChanged="OnSelectionChanged"
                                     KeyDown="OnListBoxKeyDown">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter VerticalAlignment="Top"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Footer Bar -->
        <Border x:Name="Tab1FooterBorder" Grid.Row="3" Padding="28,10,28,10"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource HeaderBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusCountText" Text="1 ventanas disponibles" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox x:Name="HideTaskbarCheckBox" Content="Ocultar también icono de la barra de tareas"
                              Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                              Click="OnHideTaskbarOptionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AdminElevateBtn" Style="{StaticResource SecondaryPillBtn}"
                            Height="26" Padding="10,0" Content="🛡️ Permisos de Administrador"
                            Click="OnElevateAdminClick"
                            ToolTip="Permite aislar ventanas elevadas del sistema como el Administrador de tareas"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab 2: Ratón señuelo y Jiggler -->
                <Border Grid.Row="2" Padding="28,14,28,14" Background="Transparent" x:Name="Tab2Content" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar with Hotkey Carousel -->
                    <RowDefinition Height="*"/>    <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- Top Bar with Hotkey Carousel -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,0" MinHeight="48" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 2C8.686 2 6 4.686 6 8v8c0 3.314 2.686 6 6 6s6-2.686 6-6V8c0-3.314-2.686-6-6-6zm0 4v4"
                                  Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ratón señuelo" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Mouse Hotkey Carousel Pill -->
                        <Border Grid.Column="1" Background="#f8fafc" BorderBrush="#e2e8f0"
                                BorderThickness="1" CornerRadius="9" Padding="10,6.5" MinHeight="36" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource CarouselNavBtn}" ToolTip="Atajo anterior" Click="OnMouseHotkeyPrevClick">
                                    <Path Data="M15 18l-6-6 6-6" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform"/>
                                </Button>
                                <TextBlock x:Name="MouseHotkeyNameText" Text="Congelar cursor:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                <Border Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                                        CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="FreezeHotkeyValueText" Text="Ctrl + Shift + F" FontSize="11"
                                               FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <Button Style="{StaticResource CarouselNavBtn}" ToolTip="Siguiente atajo" Click="OnMouseHotkeyNextClick">
                                    <Path Data="M9 18l6-6-6-6" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform"/>
                                </Button>
                                <Border Width="1" Height="12" Background="#e2e8f0" Margin="4,0"/>
                                <Button Style="{StaticResource PencilBtn}" Width="18" Height="18" ToolTip="Editar atajo" Click="OnEditCurrentMouseHotkeyClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content (2 Columns, Perfectly Aligned Bottom) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Monitor (165px) & Interactive Drawing (135px) -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. Monitor de pantalla -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,11" Margin="0,0,0,9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="204"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Title on left, live coordinates on right -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="1. Monitor de pantalla" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Visualización en tiempo real del área de pantalla (16:9) y coordenadas del cursor."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="MouseCoordinatesText" Text="X: 1280 | Y: 800" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Mini Screen Canvas with live tracking (165px) -->
                                <Border Grid.Row="1" Background="#16161a" BorderBrush="#27272a" BorderThickness="1"
                                        CornerRadius="6" ClipToBounds="True">
                                    <Grid>
                                        <!-- Top Display Header -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,8,0,0"
                                                Background="#27272a" CornerRadius="4" Padding="7,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#475569" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="PANTALLA PRINCIPAL • 2560 × 1600" FontSize="9.5" FontWeight="SemiBold" Foreground="#94a3b8"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <Canvas x:Name="MousepadMiniCanvas">
                                            <TextBlock x:Name="MouseClonePosText" Text="0, 0" Visibility="Collapsed"/>
                                            <Polyline x:Name="MousepadTrackLine" Stroke="{StaticResource AccentBlueBrush}"
                                                      StrokeThickness="1.8" StrokeDashArray="3,3"/>
                                            <!-- Lagged cursor clone preview (Red) -->
                                            <Ellipse x:Name="MousepadLagDot" Width="10" Height="10"
                                                      Fill="#ff3b30" Stroke="#ffffff" StrokeThickness="1.5" Visibility="Collapsed"/>
                                            <!-- Physical cursor dot preview (Blue) -->
                                            <Ellipse x:Name="MousepadCursorDot" Width="10" Height="10"
                                                      Fill="{StaticResource AccentBlueBrush}" Stroke="#ffffff" StrokeThickness="1.5"
                                                      Canvas.Left="180" Canvas.Top="96"/>
                                            <Ellipse x:Name="MousepadClickRipple" Width="22" Height="22"
                                                      Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5" Visibility="Collapsed"/>
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2. Pizarra de dibujo interactiva -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceWhite}"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,11">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="195"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title + Apply Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2. Pizarra de dibujo interactiva" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryPillBtn}" Height="26" Padding="12,0"
                                            Content="Usar como ruta activa" Click="OnApplyDrawingToTrackClick"/>
                                </Grid>

                                <!-- Interactive Canvas with Dot Grid Pattern -->
                                <Border Grid.Row="1" Background="#ffffff" BorderBrush="#e5e5ea" BorderThickness="1"
                                        CornerRadius="6" ClipToBounds="True">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource DotGridBrush}" Opacity="0.5"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" IsHitTestVisible="False">
                                            <Path Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                                                  Stroke="#64748b" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Haz clic en una herramienta para dibujar" FontSize="10.5" Foreground="#64748b" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Canvas x:Name="DrawingCanvas" Background="Transparent" Cursor="Arrow"
                                                MouseDown="OnDrawingCanvasMouseDown"
                                                MouseMove="OnDrawingCanvasMouseMove"
                                                MouseUp="OnDrawingCanvasMouseUp">
                                            <Polyline x:Name="DrawingPolyline" Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line x:Name="InteractiveLine" Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="2.5" Visibility="Collapsed"/>
                                            <Rectangle x:Name="InteractiveRect" Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="2.5" Visibility="Collapsed"/>
                                            <Ellipse x:Name="InteractiveCircle" Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="2.5" Visibility="Collapsed"/>

                                            <Ellipse x:Name="Handle1" Width="8" Height="8" Fill="#5b8df7" Stroke="#ffffff" StrokeThickness="1.5" Visibility="Collapsed" MouseDown="OnHandleMouseDown"/>
                                            <Ellipse x:Name="Handle2" Width="8" Height="8" Fill="#5b8df7" Stroke="#ffffff" StrokeThickness="1.5" Visibility="Collapsed" MouseDown="OnHandleMouseDown"/>
                                            <Ellipse x:Name="Handle3" Width="8" Height="8" Fill="#5b8df7" Stroke="#ffffff" StrokeThickness="1.5" Visibility="Collapsed" MouseDown="OnHandleMouseDown"/>
                                            <Ellipse x:Name="Handle4" Width="8" Height="8" Fill="#5b8df7" Stroke="#ffffff" StrokeThickness="1.5" Visibility="Collapsed" MouseDown="OnHandleMouseDown"/>
                                        </Canvas>
                                    </Grid>
                                </Border>

                                <!-- Toolbar & Metrics -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Toolbar Buttons -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="ToolFreehandBtn" Style="{StaticResource SecondaryPillBtn}" Height="24" Padding="8,0" Margin="0,0,5,0"
                                                Content="Libre" Click="OnDrawFreehandClick"/>
                                        <Button x:Name="ToolLineBtn" Style="{StaticResource SecondaryPillBtn}" Height="24" Padding="8,0" Margin="0,0,5,0"
                                                Content="Línea" Click="OnDrawLineClick"/>
                                        <Button x:Name="ToolRectBtn" Style="{StaticResource SecondaryPillBtn}" Height="24" Padding="8,0" Margin="0,0,5,0"
                                                Content="Rect" Click="OnDrawRectClick"/>
                                        <Button x:Name="ToolCircleBtn" Style="{StaticResource SecondaryPillBtn}" Height="24" Padding="8,0" Margin="0,0,5,0"
                                                Content="Círculo" Click="OnDrawCircleClick"/>
                                        <Button x:Name="ToolClearBtn" Style="{StaticResource SecondaryPillBtn}" Height="24" Padding="8,0"
                                                Content="Limpiar" Click="OnClearDrawingClick"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="MousePointsText" Text="0 pts" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="MouseDurationText" Text="0.0s" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="MouseClicksText" Text="0 izq • 0 der" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBlueBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right Column: Settings and controls -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Row 0: Header -->
                                <RowDefinition Height="2.6*"/>  <!-- Row 1: Reproducción de ruta -->
                                <RowDefinition Height="1.0*"/>  <!-- Row 2: Congelar cursor -->
                                <RowDefinition Height="1.0*"/>  <!-- Row 3: Modo Anti-inactividad -->
                                <RowDefinition Height="1.25*"/> <!-- Row 4: Cursor con latencia e inestabilidad -->
                                <RowDefinition Height="1.4*"/>  <!-- Row 5: Deriva orgánica y micro-movimiento -->
                            </Grid.RowDefinitions>

                            <!-- Header Title -->
                            <Border Grid.Row="0" Height="36" Padding="18,11,18,0" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Modos de cursor señuelo" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Top"/>
                            </Border>

                            <!-- Section 1: Cursor Clon (Ruta grabada) -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="16,6">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Reproducción de ruta" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Graba o dibuja trayectorias para reproducir un cursor clon que simula actividad humana continua."/>
                                    </StackPanel>

                                    <!-- Controls -->
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="MouseRecordBtn" Grid.Column="0" Style="{StaticResource PrimaryPillBtn}"
