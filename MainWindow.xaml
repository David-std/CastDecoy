                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                        <Border Width="9" Height="12" CornerRadius="2" Background="#e5e5ea" Margin="1.5,0"/>
                                    </StackPanel>

