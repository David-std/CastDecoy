                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content (2 Columns) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: VU Meter & Spectrum Analyzers with Audio Grid -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="15" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="Auto"/> <!-- Segmented VU Meter -->
                                <RowDefinition Height="Auto"/> <!-- Master Output Volume -->
                                <RowDefinition Height="*"/>    <!-- Original Spectrum -->
                                <RowDefinition Height="*"/>    <!-- Processed Spectrum -->
                                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                <RowDefinition Height="Auto"/> <!-- Hardware Status Bar -->
