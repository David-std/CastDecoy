                            <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Click="OnRefreshMicsClick" ToolTip="Refrescar dispositivos de audio">
                                <Path Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Mic Hotkey Carousel -->
                        <Border Grid.Column="2" Background="#f8fafc" BorderBrush="#e2e8f0"
