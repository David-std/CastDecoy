                            <!-- In Spectrum Grid with Audio Analyzer Background Grid -->
                            <Border Grid.Row="3" Background="{StaticResource SubCardBgBrush}" BorderBrush="{StaticResource SubCardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
