                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- Tab 4: Micrófono señuelo -->
                <Border Grid.Row="2" Padding="28,14,28,14" Background="Transparent" x:Name="Tab4Content" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar with Devices & Hotkey Carousel -->
                    <RowDefinition Height="*"/>    <!-- Main Content -->
