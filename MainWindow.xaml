                                        <Border Background="#ffffff" BorderBrush="#d1d1d6" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="MicVolumeText" Text="0%" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <ProgressBar x:Name="MicVuMeter" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0"/>
                                </Grid>
                            </Border>

                            <!-- Master Output Volume Slider -->
                            <Border Grid.Row="2" Background="#f8fafc" BorderBrush="#e5e5ea" BorderThickness="1"
