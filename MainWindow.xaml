                                        <Button x:Name="MousePlayBtn" Grid.Column="1" Style="{StaticResource SecondaryPillBtn}"
                                                Height="26" Padding="10,0" Content="Reproducir clon" Margin="0,0,6,0"
                                                Click="OnToggleMousePlayClick"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryPillBtn}"
                                                Height="26" Padding="8,0" Content="Limpiar"
                                                Click="OnClearMouseTrackClick"/>
                                    </Grid>

                                    <!-- Status Dot & Text -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <Ellipse x:Name="MouseRecordStatusDot" Width="6.5" Height="6.5" Fill="{StaticResource StatusGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MouseRecordStatusText" Text="Listo para reproducir o grabar" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Presets -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <TextBlock Text="Presets:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource SecondaryPillBtn}" Height="22" Padding="8,0" Margin="0,0,6,0"
                                                Content="Lectura natural" Click="OnPresetReadingClick"/>
                                        <Button Style="{StaticResource SecondaryPillBtn}" Height="22" Padding="8,0"
                                                Content="Navegación web" Click="OnPresetOfficeClick"/>
                                    </StackPanel>

                                    <!-- Options Checkboxes -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="HideOriginalMouseCheck" Grid.Column="0" Content="Ocultar ratón real"
                                                  ToolTip="Oculta tu puntero físico de las grabaciones y videollamadas mientras reproduces el señuelo, manteniéndolo visible solo para ti en tu monitor."
                                                  Style="{StaticResource CheckBoxStyle}" Margin="0,0,4,0"/>
                                        <CheckBox x:Name="RecordClicksCheck" Grid.Column="1" Content="Registrar clics"
                                                  ToolTip="Captura y simula los clics automáticamente durante la reproducción del clon."
                                                  Style="{StaticResource CheckBoxStyle}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Velocidad de reproducción:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="MouseSpeedCombo" Width="85" Height="25" SelectionChanged="OnMouseSpeedChanged">
                                            <ComboBoxItem Content="0.5x"/>
                                            <ComboBoxItem Content="1.0x" IsSelected="True"/>
                                            <ComboBoxItem Content="1.5x"/>
                                            <ComboBoxItem Content="2.0x"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Congelar cursor -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="16,6">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Congelar cursor" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Fija la posición visual del cursor en pantalla mientras puedes seguir usando el ratón real libremente."/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="DecoyToggleBtn" Style="{StaticResource SecondaryPillBtn}"
                                                Height="26" Padding="12,0" Content="Congelar cursor" Margin="0,0,10,0"
                                                Click="OnToggleFreezeDecoyClick"/>
                                        <TextBlock x:Name="DecoyStatusText" Text="Réplica inactiva: El cursor se graba normalmente."
                                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Modo Anti-inactividad -->
                            <Border Grid.Row="3" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="16,6">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Modo Anti-inactividad" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Envía micro-movimientos periódicos para evitar que Windows o aplicaciones de videollamada entren en estado inactivo."/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="AutoJitterCheck" Content="Activar prevención cada"
                                                  Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Click="OnAutoJitterCheckClicked"/>
                                        <ComboBox x:Name="AutoJitterIntervalCombo" Width="80" Height="25"
                                                  SelectionChanged="OnAutoJitterIntervalChanged">
                                            <ComboBoxItem Content="10 s"/>
                                            <ComboBoxItem Content="15 s"/>
                                            <ComboBoxItem Content="30 s" IsSelected="True"/>
                                            <ComboBoxItem Content="1 min"/>
                                            <ComboBoxItem Content="5 min"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Cursor con latencia e inestabilidad -->
                            <Border Grid.Row="4" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="16,6">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Cursor con latencia e inestabilidad" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Simula pérdida de paquetes y latencia de red visible para observadores externos en videollamadas."/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SimulateMouseLagCheck" Grid.Column="0" Content="Simular latencia y teletransporte"
                                                  Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                                                  Click="OnSimulateMouseLagCheckClicked"/>
                                        <ComboBox x:Name="MouseLagCombo" Grid.Column="1" Width="145" Height="25"
                                                  SelectionChanged="OnMouseLagChanged">
                                            <ComboBoxItem Content="100 ms • Jitter leve"/>
                                            <ComboBoxItem Content="250 ms • Pérdida leve" IsSelected="True"/>
                                            <ComboBoxItem Content="500 ms • Salto brusco"/>
                                            <ComboBoxItem Content="Pérdida de red 40%"/>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="ShowLagGhostCheck" Content="Mostrar réplica desfasada en pantalla local"
                                              Style="{StaticResource CheckBoxStyle}" Margin="0"
                                              Click="OnShowLagGhostCheckClicked"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 5: Deriva orgánica y micro-movimiento -->
                            <Border Grid.Row="5" Padding="16,6,16,14">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Deriva orgánica y micro-movimiento" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Genera oscilaciones biológicas continuas para evitar sistemas de detección de bots y patrones sintéticos."/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="OrganicDriftCheck" Grid.Column="0" Content="Micro-desplazamiento autónomo"
                                                  Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                                                  Click="OnOrganicDriftCheckClicked"/>
                                        <ComboBox x:Name="DriftPatternCombo" Grid.Column="1" Width="145" Height="25"
                                                  SelectionChanged="OnDriftPatternChanged">
                                            <ComboBoxItem Content="Oscilación biológica" IsSelected="True"/>
                                            <ComboBoxItem Content="Círculos sutiles"/>
                                            <ComboBoxItem Content="Lectura diagonal"/>
                                            <ComboBoxItem Content="Deriva a esquina segura"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="Simula micro-movimientos biológicos continuos para evitar detección de inactividad."
                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- Tab 3: Cámara señuelo -->
                <Border Grid.Row="2" Padding="28,14,28,14" Background="Transparent" x:Name="Tab3Content" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar with Devices & Hotkey Carousel -->
                    <RowDefinition Height="*"/>    <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- Top Bar: Device Selection + Refresh + Hotkey Carousel -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,0" MinHeight="48" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Path Data="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
                                  Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cámara señuelo" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Device Selection -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Dispositivo:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CamDeviceComboBox" Width="220" Height="28" Margin="0,0,10,0" SelectionChanged="OnCamDeviceChanged"/>
                            <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Click="OnRefreshDevicesClick" ToolTip="Refrescar dispositivos de cámara">
                                <Path Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Cam Hotkey Carousel -->
                        <Border Grid.Column="2" Background="#f8fafc" BorderBrush="#e2e8f0"
                                BorderThickness="1" CornerRadius="9" Padding="10,6.5" MinHeight="36" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource CarouselNavBtn}" ToolTip="Atajo anterior" Click="OnCamHotkeyPrevClick">
                                    <Path Data="M15 18l-6-6 6-6" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform"/>
                                </Button>
                                <TextBlock x:Name="CamHotkeyNameText" Text="Congelar fotograma:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                <Border Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                                        CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="CamHotkeyValueText" Text="Ctrl + Shift + C" FontSize="11"
                                               FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <Button Style="{StaticResource CarouselNavBtn}" ToolTip="Siguiente atajo" Click="OnCamHotkeyNextClick">
                                    <Path Data="M9 18l6-6-6-6" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform"/>
                                </Button>
                                <Border Width="1" Height="12" Background="#e2e8f0" Margin="4,0"/>
                                <Button Style="{StaticResource PencilBtn}" Width="18" Height="18" ToolTip="Editar atajo" Click="OnEditCurrentCamHotkeyClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content (2 Columns) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: TWO STACKED VIEWPORTS + QUALITY & STEPPED FPS -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header Viewport 1 -->
                                <RowDefinition Height="*"/>    <!-- Viewport 1 -->
                                <RowDefinition Height="Auto"/> <!-- Header Viewport 2 -->
                                <RowDefinition Height="*"/>    <!-- Viewport 2 -->
                                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                <RowDefinition Height="Auto"/> <!-- Signal Quality & Stepped FPS -->
                            </Grid.RowDefinitions>

                            <!-- Viewport 1 Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="1. Entrada directa" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Señal de video física capturada directamente desde el sensor de la cámara web seleccionada."/>
                                </StackPanel>
                                <Border Background="{StaticResource SubCardBgBrush}" BorderBrush="{StaticResource SubCardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="7,1.5" HorizontalAlignment="Right">
                                    <TextBlock Text="Sensor físico" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Viewport 1 Video Frame (RAW ORIGINAL) -->
                            <Border Grid.Row="1" Background="#0f172a" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,8" MinHeight="165">
                                <Grid>
                                    <Image x:Name="CamOriginalPreviewImage" Stretch="Uniform"/>
                                    <Border x:Name="CamOriginalInactivePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Sensor de cámara inactivo" FontSize="11.5" Foreground="#94a3b8"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Viewport 2 Header -->
                            <Grid Grid.Row="2" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="CamStatusDot" Width="6" Height="6" Fill="#94a3b8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="2. Salida transmitida" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Señal de video modificada que se emite a las aplicaciones de videollamada."/>
                                </StackPanel>
                                <Border Background="{StaticResource SubCardBgBrush}" BorderBrush="{StaticResource SubCardBorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="7,1.5" HorizontalAlignment="Right">
                                    <TextBlock x:Name="CamBadgeText" Text="Inactiva" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Viewport 2 Video Frame (DECOY SPOOFED OUTPUT) -->
                            <Border Grid.Row="3" Background="#0f172a" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,8" MinHeight="165">
                                <Grid>
                                    <Image x:Name="CamPreviewImage" Stretch="Uniform"/>
                                    <Rectangle x:Name="ColorFrameOverlay" Fill="Transparent" Visibility="Collapsed"/>
                                    
                                    <!-- Video cortado / Mitad oscura overlay -->
                                    <Grid x:Name="GlitchFrameOverlay" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="GlitchDarkBlock" Grid.Row="1" Background="#0A0D14" Opacity="0.96">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#1e293b" CornerRadius="4" Padding="8,3" Margin="0,0,0,4">
                                                    <TextBlock x:Name="GlitchStatusTitle" Text="SEÑAL CORTADA • MITAD INFERIOR OSCURA" FontSize="9.5" FontWeight="SemiBold" Foreground="#94a3b8"/>
                                                </Border>
                                                <TextBlock x:Name="GlitchStatusSubtitle" Text="Fallo de sincronía simulado" FontSize="9" Foreground="#64748b" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="GlitchDividerLine" Grid.Row="0" VerticalAlignment="Bottom" Height="2" Background="#38bdf8" Opacity="0.5"/>
                                    </Grid>

                                    <Border x:Name="CamInactivePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Transmisión inactiva" FontSize="11.5" Foreground="#94a3b8"/>
                                    </Border>
                                    <Border x:Name="LoopBufferBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#000000" Opacity="0.75" CornerRadius="4" Padding="6,2" Margin="6" Visibility="Collapsed">
                                        <TextBlock Text="Bucle activo" FontSize="9.5" Foreground="#ffffff"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Action Buttons -->
                            <Grid Grid.Row="4" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ActivateCamBtn" Grid.Column="0" Style="{StaticResource PrimaryPillBtn}"
                                        Height="28" Content="Activar cámara" Margin="0,0,6,0" Click="OnActivateCamClick"/>
                                <Button x:Name="PopoutCamBtn" Grid.Column="1" Style="{StaticResource SecondaryPillBtn}"
                                        Height="28" Content="Ventana flotante" Click="OnPopoutCamClick"/>
                            </Grid>

                            <!-- Signal Quality & FPS Control -->
                            <Border Grid.Row="5" Background="{StaticResource SubCardBgBrush}" BorderBrush="{StaticResource SubCardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 1. Calidad de transmisión Dropdown -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Calidad de señal:" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CamFormatComboBox" Grid.Column="1" Height="25" SelectionChanged="OnCamFormatChanged">
                                            <ComboBoxItem Content="1920×1080 • 60 fps"/>
                                            <ComboBoxItem Content="1280×720 • 30 fps" IsSelected="True"/>
                                            <ComboBoxItem Content="640×480 • 30 fps"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- 2. Frame Rate (FPS) Slider -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fotogramas por segundo:" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="CamFpsSlider" Grid.Column="1" Minimum="1" Maximum="60" Value="30"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Style="{StaticResource CleanSliderStyle}" ValueChanged="OnCamFpsSliderChanged"/>
                                        <Border Grid.Column="2" Background="#ffffff" BorderBrush="#d1d1d6" BorderThickness="1"
                                                CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="FpsDisplayLabel" Text="30 FPS" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBlueBrush}"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Transmission Modes (Filled with rich configuration) -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>    <!-- Header Title -->
                                <RowDefinition Height="0.85*"/>   <!-- Option 1: En vivo -->
                                <RowDefinition Height="0.75*"/>   <!-- Option 2: Congelar fotograma -->
                                <RowDefinition Height="1.15*"/>   <!-- Option 3: Señal inestable -->
                                <RowDefinition Height="1.0*"/>    <!-- Option 4: Color de espera -->
                                <RowDefinition Height="1.0*"/>    <!-- Option 5: Repetición en bucle -->
                                <RowDefinition Height="1.0*"/>    <!-- Option 6: Video cortado -->
                            </Grid.RowDefinitions>

                            <!-- Header Title -->
                            <Border Grid.Row="0" Height="36" Padding="18,11,18,0" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Modos de transmisión señuelo" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Top"/>
                            </Border>

                            <!-- Option 1: En vivo -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,5"
                                    Cursor="Hand" MouseLeftButtonDown="OnLiveOptionClick">
                                <StackPanel VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeLiveRadio" GroupName="CamModeGroup" IsChecked="True"
                                                 Style="{StaticResource RadioButtonStyle}" Click="OnCamModeRadioClicked">
                                        <TextBlock Text="En vivo" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"/>
                                    </RadioButton>
                                    <TextBlock Text="Transmite la señal directa del sensor físico a resolución nativa."
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,2,0,3" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,1,0,0">
                                        <Border Background="#f2f2f7" BorderBrush="#e5e5ea" BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                            <TextBlock Text="Perfil: Directo a hardware" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Option 2: Congelar fotograma -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,5"
                                    Cursor="Hand" MouseLeftButtonDown="OnFreezeOptionClick">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <RadioButton x:Name="ModeFreezeRadio" GroupName="CamModeGroup"
                                                     Style="{StaticResource RadioButtonStyle}" Click="OnCamModeRadioClicked">
                                            <TextBlock Text="Congelar fotograma" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"/>
