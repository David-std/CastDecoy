                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                        <TextBlock Text="Espectro procesado" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Señal acústica resultante transmitida a las aplicaciones de videollamada."/>
                                        <Border x:Name="MicEffectBadgeBorder" Background="#ffffff" BorderBrush="#d1d1d6" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Height="18" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="MicEffectBadge" Text="PASO DIRECTO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Audio Analyzer Stage -->
                                    <Grid Grid.Row="1" MinHeight="68">
                                        <!-- Audio Grid Lines (Malla de audio: dB & Frecuencia) -->
                                        <Grid Opacity="0.45" IsHitTestVisible="False">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="#c7c7cc" BorderThickness="0,1,0,0">
                                                <TextBlock Text="0 dB" FontSize="8.5" Foreground="#86868b" HorizontalAlignment="Left" Margin="2,2,0,0"/>
                                            </Border>
                                            <Border Grid.Row="1" BorderBrush="#e5e5ea" BorderThickness="0,1,0,0">
                                                <TextBlock Text="-12 dB" FontSize="8.5" Foreground="#86868b" HorizontalAlignment="Left" Margin="2,-8,0,0"/>
                                            </Border>
                                            <Border Grid.Row="2" BorderBrush="#e5e5ea" BorderThickness="0,1,0,0">
                                                <TextBlock Text="-24 dB" FontSize="8.5" Foreground="#86868b" HorizontalAlignment="Left" Margin="2,-8,0,0"/>
                                            </Border>
                                            <Border Grid.Row="3" BorderBrush="#e5e5ea" BorderThickness="0,1,0,0">
                                                <TextBlock Text="-48 dB" FontSize="8.5" Foreground="#86868b" HorizontalAlignment="Left" Margin="2,-8,0,0"/>
                                            </Border>
                                        </Grid>

                                        <!-- Frequency Markers at Bottom -->
                                        <Grid Opacity="0.5" VerticalAlignment="Bottom" Margin="30,0,8,0" IsHitTestVisible="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="100Hz" FontSize="8" Foreground="#86868b"/>
                                            <TextBlock Grid.Column="1" Text="500Hz" FontSize="8" Foreground="#86868b"/>
                                            <TextBlock Grid.Column="2" Text="1kHz" FontSize="8" Foreground="#86868b"/>
                                            <TextBlock Grid.Column="3" Text="5kHz" FontSize="8" Foreground="#86868b"/>
                                            <TextBlock Grid.Column="4" Text="20kHz" FontSize="8" Foreground="#86868b" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Animated Responsive Bars (Multi-band Equalizer) -->
                                        <UniformGrid x:Name="OutSpectrumGrid" Rows="1" Margin="28,0,16,12" VerticalAlignment="Bottom" Height="58"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Buttons -->
                            <Grid Grid.Row="5" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ActivateMicBtn" Grid.Column="0" Style="{StaticResource PrimaryPillBtn}"
                                        Height="28" Content="Activar micrófono" Margin="0,0,10,0" Click="OnActivateMicClick"/>
                                <CheckBox x:Name="MonitorAudioCheckBox" Grid.Column="1" Content="Escuchar salida"
                                          Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                                          Click="OnMonitorAudioChecked"/>
                            </Grid>

                            <!-- Hardware Status Bar -->
                            <Border Grid.Row="6" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1"
                                    CornerRadius="6" Padding="12,5">
                                <Grid>
                                    <TextBlock Text="Muestreo: 48,000 Hz  •  Latencia: &lt; 5 ms  •  24-bit Digital"
                                               FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Audio Effects (Expanded with interactive controls) -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header Title -->
                                <RowDefinition Height="*"/>    <!-- Option 1: En vivo -->
                                <RowDefinition Height="*"/>    <!-- Option 2: Mute falso -->
                                <RowDefinition Height="*"/>    <!-- Option 3: Voz entrecortada -->
                                <RowDefinition Height="*"/>    <!-- Option 4: Eco doble -->
                                <RowDefinition Height="*"/>    <!-- Option 5: Ruido blanco -->
                                <RowDefinition Height="*"/>    <!-- Option 6: Saturación y ganancia -->
                            </Grid.RowDefinitions>

                            <!-- Header Title -->
                            <Border Grid.Row="0" Height="36" Padding="18,11,18,0" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Efectos de audio señuelo" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Top"/>
                            </Border>

                            <!-- Option 1: En vivo -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,10"
                                    Cursor="Hand" MouseLeftButtonDown="OnMicNormalOptionClick">
                                <StackPanel VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeMicNormalRadio" GroupName="MicModeGroup" IsChecked="True"
                                                 Style="{StaticResource RadioButtonStyle}" Click="OnMicModeRadioClicked">
                                        <TextBlock Text="En vivo" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    </RadioButton>
                                    <TextBlock Text="Paso directo digital a 48,000 Hz y 24-bit sin alteraciones acústicas."
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="26,3,0,4" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                        <Border Background="#f2f2f7" BorderBrush="#e5e5ea" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Perfil: Paso directo a hardware" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Option 2: Mute falso indetectable -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,10"
                                    Cursor="Hand" MouseLeftButtonDown="OnMicFakeMuteOptionClick">
                                <StackPanel VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeMicFakeMuteRadio" GroupName="MicModeGroup"
                                                 Style="{StaticResource RadioButtonStyle}" Click="OnMicModeRadioClicked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Mute falso indetectable" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Silencia la salida manteniendo la sesión y el hardware activos para evitar avisos."/>
                                        </StackPanel>
                                    </RadioButton>
                                    <TextBlock Text="Silencia la salida manteniendo la sesión y el hardware activos para evitar avisos."
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="26,3,0,4" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                        <Button x:Name="ToggleFakeMuteBtn" Style="{StaticResource SecondaryPillBtn}"
                                                Height="24" Padding="12,0" Content="Silenciar ahora" VerticalAlignment="Center"
                                                Click="OnToggleFakeMuteClick"/>
                                        <Border Background="#f2f2f7" BorderBrush="#e5e5ea" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hardware: Activo en sesión" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Option 3: Voz entrecortada -->
                            <Border Grid.Row="3" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,10"
                                    Cursor="Hand" MouseLeftButtonDown="OnMicChoppyOptionClick">
                                <StackPanel VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeMicChoppyRadio" GroupName="MicModeGroup"
                                                 Style="{StaticResource RadioButtonStyle}" Click="OnMicModeRadioClicked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Voz entrecortada" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Simula microcortes y pérdida de paquetes de audio típicos de una red inestable."/>
                                        </StackPanel>
                                    </RadioButton>
                                    <TextBlock Text="Simula microcortes y pérdida de paquetes típicos de red inestable."
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="26,3,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                        <TextBlock Text="Descarte de paquetes:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="ChoppyRateCombo" Width="175" Height="24" SelectionChanged="OnChoppyRateChanged">
                                            <ComboBoxItem Content="25% • Leve fluctuación"/>
                                            <ComboBoxItem Content="50% • Pérdida media" IsSelected="True"/>
                                            <ComboBoxItem Content="75% • Microcortes graves"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Option 4: Eco doble -->
                            <Border Grid.Row="4" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,10"
                                    Cursor="Hand" MouseLeftButtonDown="OnMicEchoOptionClick">
                                <StackPanel VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeMicEchoRadio" GroupName="MicModeGroup"
                                                 Style="{StaticResource RadioButtonStyle}" Click="OnMicModeRadioClicked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Eco doble y reverberación" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Inyecta retorno acústico simulando eco en altavoces o sala vacía."/>
                                        </StackPanel>
                                    </RadioButton>
                                    <TextBlock Text="Inyecta retorno acústico simulando eco en altavoces o sala vacía."
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="26,3,0,4" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                        <TextBlock Text="Tipo y retardo:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="EchoDelayCombo" Width="220" Height="24" SelectionChanged="OnEchoDelayChanged">
                                            <ComboBoxItem Content="Eco doble y largo • Sala amplia" IsSelected="True"/>
                                            <ComboBoxItem Content="Eco múltiple 120 ms • Sala corta"/>
                                            <ComboBoxItem Content="Eco múltiple 180 ms • Oficina vacía"/>
                                            <ComboBoxItem Content="Eco múltiple 260 ms • Retorno hueco"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Option 5: Ruido blanco -->
                            <Border Grid.Row="5" BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,10"
                                    Cursor="Hand" MouseLeftButtonDown="OnMicStaticOptionClick">
                                <StackPanel VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeMicStaticRadio" GroupName="MicModeGroup"
                                                 Style="{StaticResource RadioButtonStyle}" Click="OnMicModeRadioClicked">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Ruido blanco y estática" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource HelpInfoCircle}" ToolTip="Añade interferencia continua analógica y zumbido electromagnético suave."/>
                                        </StackPanel>
                                    </RadioButton>
                                    <TextBlock Text="Añade interferencia continua analógica y zumbido electromagnético suave."
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="26,3,0,4" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                        <TextBlock Text="Tipo de señal:" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="StaticTypeCombo" Width="210" Height="24" SelectionChanged="OnStaticTypeChanged">
                                            <ComboBoxItem Content="Zumbido eléctrico 50-60 Hz" IsSelected="True"/>
                                            <ComboBoxItem Content="Ruido blanco continuo"/>
                                            <ComboBoxItem Content="Estática sibilante de cable"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Option 6: Saturación y ganancia -->
                            <Border Grid.Row="6" Padding="18,10" Cursor="Hand" MouseLeftButtonDown="OnMicSaturationOptionClick">
                                <StackPanel VerticalAlignment="Center">
                                    <RadioButton x:Name="ModeMicSaturationRadio" GroupName="MicModeGroup"
                                                 Style="{StaticResource RadioButtonStyle}" Click="OnMicModeRadioClicked">
                                        <TextBlock Text="Saturación y ganancia extrema" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    </RadioButton>
                                    <TextBlock Text="Sobreamplifica la señal simulando saturación de hardware."
                                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="26,3,0,4"/>
                                    <Grid Margin="26,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="MicSaturationSlider" Grid.Column="0" Minimum="2" Maximum="20" Value="15"
                                                Style="{StaticResource CleanSliderStyle}" ValueChanged="OnMicSaturationSliderChanged"/>
                                        <TextBlock x:Name="SaturationLevelText" Grid.Column="1" Text="x15 • Alta" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <!-- Tab 5: Atajos globales -->
        <Border Grid.Row="2" Padding="28,16,28,16" Background="Transparent" x:Name="Tab5Content" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Global Shortcuts -->
                    <RowDefinition Height="*"/>    <!-- App Shortcuts List -->
                </Grid.RowDefinitions>

                <!-- System Hotkeys Card -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Title -->
                        <Border BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"
                                      Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5"
                                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Atajos globales del sistema" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Row 1: App Visibility -->
                        <Border BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                            <Grid>
                                <TextBlock Text="Abrir o minimizar CastDecoy" FontSize="12.5" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                                            CornerRadius="4" Padding="8,2.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelfHotkeyValueText" Text="Ctrl + Shift + H" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button Style="{StaticResource PencilBtn}" Click="OnEditSelfHotkeyClick" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 2: Freeze Mouse -->
                        <Border BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                            <Grid>
                                <TextBlock Text="Congelar cursor señuelo" FontSize="12.5" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TileFreezeStatusText" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                                            CornerRadius="4" Padding="8,2.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl + Shift + F" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button Style="{StaticResource PencilBtn}" Click="OnEditFreezeHotkeyClick" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 3: Cam Decoy -->
                        <Border BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                            <Grid>
                                <TextBlock Text="Congelar cámara señuelo" FontSize="12.5" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TileCamStatusText" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                                            CornerRadius="4" Padding="8,2.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl + Shift + C" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button Style="{StaticResource PencilBtn}" Click="OnEditCamHotkeyClick" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 4: Mic Decoy -->
                        <Border Padding="18,13">
                            <Grid>
                                <TextBlock Text="Mute falso de micrófono" FontSize="12.5" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TileMicStatusText" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                                            CornerRadius="4" Padding="8,2.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl + Shift + M" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button Style="{StaticResource PencilBtn}" Click="OnEditMicHotkeyClick" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- App Shortcuts Card -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceWhite}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Atajos para abrir o minimizar ventanas individuales" FontSize="13.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Asigna combinaciones rápidas para conmutar cualquier ventana de forma independiente."
                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="AppShortcutsListBox" Grid.Row="1" Background="Transparent"
                                  BorderThickness="0" ItemTemplate="{StaticResource AppShortcutTemplate}"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="0,0,4,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>