<Window x:Class="CastDecoy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CastDecoy"
        Icon="Assets/icon.png"
        Height="780" Width="1000" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif" FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        StateChanged="OnStateChanged">

    <Window.Resources>
        <!-- Modern Premium ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="6" Padding="10,7" MaxWidth="320" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                  Color="#000000" Opacity="0.30"/>
                            </Border.Effect>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#f8fafc"
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Help Info Circle Badge (?) with ToolTip -->
        <Style x:Key="HelpInfoCircle" TargetType="ContentControl">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="40"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <EventSetter Event="MouseLeftButtonDown" Handler="OnHelpCircleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="HoverBorder" Background="Transparent" Padding="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" SnapsToDevicePixels="True">
                                <Canvas Width="24" Height="24">
                                    <Ellipse x:Name="CircleBg" Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                             Fill="#f1f5f9"/>
                                    <Ellipse x:Name="CircleBorder" Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                             Stroke="#cbd5e1" StrokeThickness="1.5"/>
                                    <Path x:Name="QMarkPath"
                                          Data="M 9.09 9 A 3 3 0 0 1 14.92 10 C 14.92 12 12 13 12 14"
                                          Stroke="#64748b" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line x:Name="QMarkDot"
                                          X1="12" Y1="17.2" X2="12.01" Y2="17.2"
                                          Stroke="#64748b" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBg" Property="Fill" Value="#ebf2fe"/>
                                <Setter TargetName="CircleBorder" Property="Stroke" Value="#3b82f6"/>
                                <Setter TargetName="QMarkPath" Property="Stroke" Value="#2563eb"/>
                                <Setter TargetName="QMarkDot" Property="Stroke" Value="#2563eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Browser Chip Style -->
        <Style x:Key="BrowserChipActiveStyle" TargetType="Button" BasedOn="{StaticResource SecondaryPillBtn}">
            <Setter Property="Background" Value="#ebf2fe"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Split Pill Left (Browser Select) Button Style -->
        <Style x:Key="SplitPillLeftBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="9,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LeftBd" Background="{TemplateBinding Background}"
                                CornerRadius="13,0,0,13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LeftBd" Property="Background" Value="#12000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LeftBd" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Split Pill Right (Edit Path) Button Style -->
        <Style x:Key="SplitPillRightBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RightBd" Background="{TemplateBinding Background}"
                                CornerRadius="0,13,13,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RightBd" Property="Background" Value="#18000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RightBd" Property="Background" Value="#28000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Window Card Item Template -->
        <DataTemplate x:Key="WindowCardTemplate">
            <Grid Margin="6" Height="172" HorizontalAlignment="Stretch"
                  SnapsToDevicePixels="True" UseLayoutRounding="True"
                  RenderOptions.ClearTypeHint="Enabled"
                  TextOptions.TextFormattingMode="Display"
                  TextOptions.TextRenderingMode="ClearType">

                <!-- Drop Shadow Border -->
                <Border x:Name="CardShadow" Background="{StaticResource SurfaceWhite}"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Color="#000000" Opacity="0.06"/>
                    </Border.Effect>
                </Border>

                <!-- Card Content Border -->
                <Border x:Name="CardBorder" Background="{StaticResource SurfaceWhite}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Cursor="Hand"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True" UseLayoutRounding="True"
                        MouseLeftButtonDown="OnItemDoubleClick">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="128"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <!-- Thumbnail Area -->
                        <Border x:Name="ThumbBorder" Grid.Row="0" Background="#f2f2f7" CornerRadius="9,9,0,0" ClipToBounds="True">
                            <Grid>
                                <!-- Fallback Icon & Title -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="42" Height="42" Margin="0,0,0,6" HorizontalAlignment="Center"
                                            Background="{Binding IconBackground}" BorderBrush="{Binding IconBorderBrush}" BorderThickness="1" CornerRadius="8"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               RenderOptions.EdgeMode="Aliased"
                                               SnapsToDevicePixels="True"/>
                                    </Border>
                                    <TextBlock Text="{Binding ProcessName}" FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                </StackPanel>

                                <!-- DWM Thumbnail -->
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderOptions.EdgeMode="Aliased"
                                       SnapsToDevicePixels="True"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Eye button -->
                                <Border x:Name="EyeBtnBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                        Width="26" Height="26" CornerRadius="5" Background="#ffffff"
                                        BorderBrush="#e5e5ea" BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonDown="OnCardEyeClick">
                                    <Path x:Name="EyeIcon"
                                          Data="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"
                                          Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Bottom Bar -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceWhite}"
                                BorderBrush="{StaticResource DividerLineBrush}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,9,9" Padding="12,0"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Process Icon -->
                                <Border Grid.Column="0" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{Binding IconBackground}" BorderBrush="{Binding IconBorderBrush}" BorderThickness="1" CornerRadius="5"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderOptions.EdgeMode="Aliased"
                                           SnapsToDevicePixels="True"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Window Title -->
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType"
                                           ToolTip="{Binding Title}"/>

                                <!-- Toggle Switch -->
                                <ToggleButton Grid.Column="2" IsChecked="{Binding IsGhosted, Mode=OneWay}"
                                              Click="OnWindowToggleClick"
                                              Style="{StaticResource MiniToggleSwitchStyle}"
                                              ToolTip="Excluir de captura de pantalla"
                                              Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Selected State -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
                <!-- Ghosted State -->
                <DataTrigger Binding="{Binding IsGhosted}" Value="True">
                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.80"/>
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#d1d1d6"/>
                    <Setter TargetName="EyeIcon" Property="Data" Value="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24 M1 1l22 22"/>
                    <Setter TargetName="EyeIcon" Property="Stroke" Value="#8e8e93"/>
                    <Setter TargetName="EyeBtnBorder" Property="Background" Value="#f2f2f7"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- App Shortcut Item Template -->
        <DataTemplate x:Key="AppShortcutTemplate">
            <Border Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Icon Tile -->
                    <Border Grid.Column="0" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"
                            Background="{Binding IconBackground}" BorderBrush="{Binding IconBorderBrush}" BorderThickness="1" CornerRadius="6"
                            ClipToBounds="True">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <!-- Universal fallback vector: shown ONLY when Icon is null -->
                            <Path x:Name="FallbackPath" Data="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6zm2 1v2h12V7H6zm0 4v7h12v-7H6z"
                                  Fill="#8e8e93" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                            <!-- Actual App Icon -->
                            <Image x:Name="AppIconImg" Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Aliased"
                                   SnapsToDevicePixels="True"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProcessName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1.5,0,0"/>
                    </StackPanel>

                    <!-- Hotkey Badge -->
                    <Border Grid.Column="2" Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                            CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding KeyGestureText, FallbackValue='Ctrl + Alt + W'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Edit Button -->
                    <Button Grid.Column="3" Style="{StaticResource PencilBtn}" Width="20" Height="20"
                            Click="OnEditAppShortcutClick" VerticalAlignment="Center" ToolTip="Editar atajo"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="FallbackPath" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="AppIconImg" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Tabs -->
            <RowDefinition Height="*"/>    <!-- 2: Tab Content -->
            <RowDefinition Height="Auto"/> <!-- 3: Footer (Tab 1) -->
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource HeaderBorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,12,28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Logo & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/icon.png" Height="26" Width="34"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" UseLayoutRounding="True"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"><Run Text="Cast" FontWeight="Bold" FontSize="20" Foreground="#6b6d72" FontFamily="pack://application:,,,/Assets/Kanit-Bold.ttf#Kanit"/><Run Text="Decoy" FontWeight="Bold" FontSize="20" Foreground="#5b8df7" FontFamily="pack://application:,,,/Assets/Kanit-Bold.ttf#Kanit"/></TextBlock>
                    <Border Width="1" Height="18" Background="{StaticResource DividerLineBrush}"
                            Margin="14,0,14,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Centro de privacidad, aislamiento de captura y control de transmisiones"
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Auto-hide App Toggle + Global Hotkey -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Auto-ocultar app" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="SelfHideSwitch" Style="{StaticResource MiniToggleSwitchStyle}"
                                  IsChecked="True" Click="OnSelfHideToggleClick"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="Ocultar la ventana de CastDecoy de capturas y grabaciones"/>

                    <!-- Global Hotkey Badge -->
                    <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="9"
                            Padding="10,6.5" MinHeight="36" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="OnEditSelfHotkeyClick"
                            ToolTip="Haz clic para modificar el atajo global de visualización">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Abrir:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border Background="#f2f2f7" BorderBrush="#d1d1d6" BorderThickness="1"
                                    CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderHotkeyValueText" Text="Ctrl + Shift + H" FontSize="11"
                                           FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                            <Button Style="{StaticResource PencilBtn}" Width="16" Height="16"
                                    Margin="6,0,0,0" Click="OnEditSelfHotkeyClick" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource HeaderBorderBrush}" BorderThickness="0,0,0,1"
                Padding="28,0,28,0">
            <StackPanel Orientation="Horizontal">
                <!-- Tab 1: Pantalla -->
                <Border x:Name="Tab1Container" Cursor="Hand" Margin="0,0,28,0" MouseDown="OnTab1Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,10" VerticalAlignment="Center">
                            <Path Data="M20 3H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-8 14v4m-4 0h8"
                                  Stroke="{Binding Path=Foreground, ElementName=Tab1Text}" StrokeThickness="1.5"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Tab1Text" Text="Pantalla" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Tab1Indicator" Height="3" Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="1.5,1.5,0,0" Visibility="Visible"/>
                    </StackPanel>
                </Border>

                <!-- Tab 2: Ratón -->
                <Border x:Name="Tab2Container" Cursor="Hand" Margin="0,0,28,0" MouseDown="OnTab2Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,10" VerticalAlignment="Center">
                            <Path Data="M12 2C8.686 2 6 4.686 6 8v8c0 3.314 2.686 6 6 6s6-2.686 6-6V8c0-3.314-2.686-6-6-6zm0 4v4"
                                  Stroke="{Binding Path=Foreground, ElementName=Tab2Text}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Tab2Text" Text="Ratón" FontSize="13" FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Tab2Indicator" Height="3" Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="1.5,1.5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Tab 3: Cámara -->
                <Border x:Name="Tab3Container" Cursor="Hand" Margin="0,0,28,0" MouseDown="OnTab3Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,10" VerticalAlignment="Center">
                            <Path Data="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
                                  Stroke="{Binding Path=Foreground, ElementName=Tab3Text}" StrokeThickness="1.5"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Tab3Text" Text="Cámara" FontSize="13" FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Tab3Indicator" Height="3" Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="1.5,1.5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Tab 4: Micrófono -->
                <Border x:Name="Tab4Container" Cursor="Hand" Margin="0,0,28,0" MouseDown="OnTab4Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,10" VerticalAlignment="Center">
                            <Path Data="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z M19 10v2a7 7 0 0 1-14 0v-2 M12 19v4 M8 23h8"
                                  Stroke="{Binding Path=Foreground, ElementName=Tab4Text}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Tab4Text" Text="Micrófono" FontSize="13" FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Tab4Indicator" Height="3" Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="1.5,1.5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Tab 5: Atajos -->
                <Border x:Name="Tab5Container" Cursor="Hand" MouseDown="OnTab5Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,10" VerticalAlignment="Center">
                            <Path Data="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"
                                  Stroke="{Binding Path=Foreground, ElementName=Tab5Text}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Tab5Text" Text="Atajos" FontSize="13" FontWeight="Normal"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Tab5Indicator" Height="3" Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="1.5,1.5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tab 1: Pantalla y Ventanas -->
