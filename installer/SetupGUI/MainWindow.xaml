<Window x:Class="CastDecoySetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador de CastDecoy" Height="435" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Assets/icon.ico"
        Background="#f8fafc" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563eb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#cbd5e1"/>
                                <Setter Property="Foreground" Value="#64748b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#fee2e2"/>
            <Setter Property="Foreground" Value="#dc2626"/>
            <Setter Property="BorderBrush" Value="#fca5a5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#fecaca"/>
                                <Setter Property="Foreground" Value="#b91c1c"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#cbd5e1"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/icon.png" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"
                               Margin="0,0,0,2"><Run Text="Cast" FontWeight="Bold" FontSize="21" Foreground="#6b6d72" FontFamily="pack://application:,,,/Assets/Kanit-Bold.ttf#Kanit"/><Run Text="Decoy" FontWeight="Bold" FontSize="21" Foreground="#5b8df7" FontFamily="pack://application:,,,/Assets/Kanit-Bold.ttf#Kanit"/><Run Text=" Setup" FontWeight="SemiBold" FontSize="16" Foreground="#64748b" FontFamily="Segoe UI"/></TextBlock>
                    <TextBlock Text="Aislamiento de Pantalla y Simulación de Señal para Windows" FontSize="11.5" Foreground="#64748b"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="18,14">
            <StackPanel VerticalAlignment="Center">
                <!-- Already installed banner -->
                <Border x:Name="AlreadyInstalledBanner" Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock Text="CastDecoy ya está instalado en este equipo." FontSize="11.5" FontWeight="SemiBold" Foreground="#1d4ed8"/>
                </Border>

                <TextBlock Text="Carpeta de destino:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                    <TextBlock x:Name="DestinationPathText" Text="C:\Users\...\AppData\Local\Programs\CastDecoy" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Options -->
                <CheckBox x:Name="DesktopShortcutCheck" Content="Crear acceso directo en el Escritorio" IsChecked="True" FontSize="12" Foreground="#1e293b" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartMenuShortcutCheck" Content="Crear acceso directo en el Menú Inicio" IsChecked="True" FontSize="12" Foreground="#1e293b" Margin="0,0,0,8"/>
                <CheckBox x:Name="LaunchAfterCheck" Content="Ejecutar CastDecoy al finalizar la instalación" IsChecked="True" FontSize="12" Foreground="#1e293b" Margin="0,0,0,12"/>

                <!-- Progress Bar and Status -->
                <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6" Background="#e2e8f0" Foreground="#3b82f6"/>
                <TextBlock x:Name="StatusText" Text="Listo para instalar" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Versión 1.0.0 • x64 • Windows 10/11" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="UninstallBtn" Content="Desinstalar" Style="{StaticResource DangerBtn}" Height="34" Padding="16,0" Margin="0,0,8,0" Visibility="Collapsed" Click="OnUninstallClick"/>
                <Button x:Name="InstallBtn" Content="Instalar ahora" Style="{StaticResource PrimaryBtn}" Height="34" Padding="20,0" Click="OnInstallClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
