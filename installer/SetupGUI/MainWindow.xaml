<Window x:Class="CastDecoySetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador de CastDecoy" Height="480" Width="530"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Assets/icon.ico"
        Background="#f5f5f7" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Primary Action Button (Brand Blue, Smooth Radius) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#5b8df7"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#4a7de6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4a7de6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#396ed6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#396ed6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2f5db8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#e5e5ea"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#d1d1d6"/>
                                <Setter Property="Foreground" Value="#8e8e93"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Neutral Action Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#f2f2f7"/>
            <Setter Property="Foreground" Value="#1d1d1f"/>
            <Setter Property="BorderBrush" Value="#d1d1d6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e8e8ed"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#c7c7cc"/>
                                <Setter Property="Foreground" Value="#b91c1c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dedee3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#b8b8be"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#f2f2f7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#e5e5ea"/>
                                <Setter Property="Foreground" Value="#8e8e93"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e5e5ea" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/icon.png" Width="44" Height="44" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"
                               LineStackingStrategy="BlockLineHeight" LineHeight="26"
                               Padding="0,2,0,2"><Run Text="Cast" FontWeight="Bold" FontSize="21" Foreground="#6b6d72" FontFamily="pack://application:,,,/Assets/Kanit-Bold.ttf#Kanit"/><Run Text="Decoy" FontWeight="Bold" FontSize="21" Foreground="#5b8df7" FontFamily="pack://application:,,,/Assets/Kanit-Bold.ttf#Kanit"/><Run Text=" Setup" FontWeight="SemiBold" FontSize="16" Foreground="#86868b" FontFamily="Segoe UI"/></TextBlock>
                    <TextBlock Text="Aislamiento de Pantalla y Simulación de Señal para Windows" FontSize="11.5" Foreground="#86868b" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Background="#ffffff" BorderBrush="#e5e5ea" BorderThickness="1" CornerRadius="10" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="AlreadyInstalledBanner" Background="#f5f5f7" BorderBrush="#e5e5ea" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="CastDecoy ya se encuentra instalado en este equipo." FontSize="11.5" FontWeight="SemiBold" Foreground="#1d1d1f"/>
                        <TextBlock Text="Puedes reinstalar para actualizar los archivos o desinstalar la versión actual." FontSize="11" Foreground="#86868b" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Carpeta de destino:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <Border Background="#f5f5f7" BorderBrush="#e5e5ea" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <TextBlock x:Name="DestinationPathText" Text="C:\Users\...\AppData\Local\Programs\CastDecoy" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <CheckBox x:Name="DesktopShortcutCheck" Content="Crear acceso directo en el Escritorio" IsChecked="True" FontSize="12" Foreground="#1e293b" Margin="0,0,0,7"/>
                    <CheckBox x:Name="StartMenuShortcutCheck" Content="Crear acceso directo en el Menú Inicio" IsChecked="True" FontSize="12" Foreground="#1e293b" Margin="0,0,0,7"/>
                    <CheckBox x:Name="LaunchAfterCheck" Content="Ejecutar CastDecoy al finalizar la instalación" IsChecked="True" FontSize="12" Foreground="#1e293b" Margin="0,0,0,4"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <ProgressBar x:Name="InstallProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6" Background="#e5e5ea" Foreground="#5b8df7"/>
                    <TextBlock x:Name="StatusText" Text="Listo para instalar" FontSize="11" Foreground="#86868b" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Versión 1.0.0 • x64 • Windows 10/11" FontSize="11" Foreground="#86868b" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="UninstallBtn" Content="Desinstalar" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Visibility="Collapsed" Click="OnUninstallClick"/>
                <Button x:Name="InstallBtn" Content="Instalar ahora" Style="{StaticResource PrimaryBtn}" Click="OnInstallClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
