<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CastDecoySetup</RootNamespace>
    <AssemblyName>CastDecoy-Setup</AssemblyName>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\Assets\icon.ico" Link="Assets\icon.ico" />
    <Resource Include="..\..\Assets\icon.png" Link="Assets\icon.png" />
    <Resource Include="..\..\Assets\brand.png" Link="Assets\brand.png" />
    <Resource Include="..\..\Assets\Kanit-Bold.ttf" Link="Assets\Kanit-Bold.ttf" />
    <EmbeddedResource Include="..\..\dist\CastDecoy-v1.0.0-win-x64.zip">
      <LogicalName>CastDecoyPackage.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
